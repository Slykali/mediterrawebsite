# Supabase: Project Settings > API. Both are server-only; neither is ever
# sent to the browser, so neither gets a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The address shown in the footer and the privacy notice. Use a mailbox the
# school or an adult mentor controls. Left empty, the site points to Instagram.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. On Vercel the production domain is picked up automatically; set
# this once you add a custom domain.
NEXT_PUBLIC_SITE_URL=
